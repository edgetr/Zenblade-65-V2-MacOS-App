{
  "name": "zenblade",
  "productName": "Zenblade",
  "version": "0.2.1",
  "description": "Mac app for the Pwnage Zenblade 65 V2 keyboard",
  "author": "edgetr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/edgetr/Zenblade-65-V2-MacOS-App.git"
  },
  "homepage": "https://github.com/edgetr/Zenblade-65-V2-MacOS-App",
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "build": "npm run build:icons && tauri build --bundles app",
    "build:icons": "bash scripts/build-icons.sh",
    "test": "node --experimental-default-type=module --test && cargo test --quiet --manifest-path src-tauri/Cargo.toml",
    "install-app": "bash scripts/install.sh",
    "update": "bash scripts/install.sh",
    "release": "bash scripts/release.sh",
    "release:publish": "bash scripts/release.sh --publish",
    "preview:release": "node scripts/preview-release.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6"
  }
}
